<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.codex.xiaominfcprobe" android:versionCode="10" android:versionName="0.10-completion-polling-fix">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
  <uses-permission android:name="com.miui.mishare.PERMISSION.ALL" />
  <uses-permission android:name="com.xiaomi.mi_connect_service.permission.RECEIVE_ENDPOINT" />
  <uses-permission android:name="android.permission.NFC" />
  <queries><package android:name="com.miui.mishare.connectivity" /></queries>
  <application android:label="碰传桥接测试" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:debuggable="true">
    <activity android:name=".ProbeActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <provider android:name=".ProbeProvider" android:authorities="local.codex.xiaominfcprobe.files" android:exported="false" android:grantUriPermissions="true" />
    <receiver android:name=".BackgroundNfcProbeReceiver" android:exported="true" android:permission="android.permission.DUMP" />
    <provider android:name=".BridgeImageProvider" android:authorities="local.codex.xiaominfcprobe.shared" android:exported="false" android:grantUriPermissions="true" />
    <service android:name=".GalleryBridgeService" android:label="碰传桥接测试" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/bridge_accessibility" />
    </service>
    <activity android:name=".ShareReceiveActivity" android:exported="false" android:enabled="false" />
    <activity android:name=".BridgeTriggerActivity" android:exported="true" android:excludeFromRecents="true" android:theme="@android:style/Theme.NoDisplay">
      <intent-filter><action android:name="android.nfc.action.NDEF_DISCOVERED"/><category android:name="android.intent.category.DEFAULT"/><data android:scheme="xiaomi-photo-bridge" android:host="send" android:path="/desk-1" /></intent-filter>
    </activity>
    <activity android:name=".BridgeTagWriterActivity" android:exported="false" />
  </application>
</manifest>
